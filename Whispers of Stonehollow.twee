  <source src="videos/millacrawler.mp4" type="video/mp4">
</video>
(set: $hpBars to (floor: $enemyHpCrawler / $enemyMaxHpCrawler * 10))
(set: $hpEmpty to 10 - $hpBars)
Millcrawler *Damage 10-20* HP: [(str-repeated: $hpBars, "█")(str-repeated: $hpEmpty, "░")] (print: $enemyHpCrawler)/(print: $enemyMaxHpCrawler)
(set: $pBars to (floor: $playerHp / $playerMaxHp * 10))
(set: $pEmpty to 10 - $pBars)
Your HP: [(str-repeated: $pBars, "█")(str-repeated: $pEmpty, "░")] (print: $playerHp)/(print: $playerMaxHp)
(link: "Attack")[
  (set: $dmg to (random: 30, 50))
  (set: $enemyDmg to (random: 10, 20))
  (set: $enemyHpCrawler to (max: 0, $enemyHpCrawler - $dmg))
