:: StoryStylesheet [stylesheet]
/* Whispers of Stonehollow */

tw-story {
    background-color: #121212;
    color: #dddddd;

    width: 100%;
    max-width: none;

    margin: 0 auto;
}


/* Kuvat */

img, video {
    width: 100%;
    max-width: 1200px;
    height: auto;
    display: block;
    margin: 0 auto;
}

/* Otsikot */

h2 {
    font-size: 2rem;
    margin-top: 10px;
    margin-bottom: 15px;
    color: #f0f0f0;
}

/* Linkit */

tw-link {
    color: #d1a85d;
    font-weight: bold;
    text-decoration: none;
}

tw-link:hover {
    color: #f2c97d;
}

.glow-text {
  color: cyan;
  text-shadow: 0 0 5px cyan, 0 0 10px cyan, 0 0 20px cyan;
  font-weight: bold;
}

.enemy-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.enemy-box img {
  display: block;
  margin-bottom: 5px;
}

.hp-bar-container {
  width: 250px;
  height: 20px;
  background: #333;
  border: 2px solid #000;
}

.hp-bar-fill {
  height: 100%;
  background: red;
  transition: width 0.3s ease;
}

.inventory-panel {
  border: 1px solid #888;
  background: #111;
  padding: 16px;
  font-family: monospace;
  max-width: 500px;
  margin: 20px auto;
}

.inventory-panel::before {
  content: "═══════ INVENTORY ═══════";
  display: block;
  text-align: center;
  color: #aaa;
  margin-bottom: 10px;
}

.journal-panel {
  border: 1px solid #888;
  background: #111;
  padding: 16px;
  font-family: monospace;
  max-width: 500px;
  margin: 20px auto;
}

.journal-panel::before {
  content: "═══════ JOURNAL ═══════";
  display: block;
  text-align: center;
  color: #aaa;
  margin-bottom: 10px;
}

.hp-hud {
  position: fixed;
  top: 10px;
  right: 10px;
  background: #111;
  border: 1px solid #888;
  padding: 6px 12px;
  font-family: monospace;
  color: #eee;
  z-index: 1000;
  border-radius: 4px;
}

tw-include[type="header"] {
  display: block;
  height: 0;
  overflow: visible;
}