:: Follow the tracks {"position":"2300,1125","size":"100,100"}
(if: $rangerMap is 0)[
<img src="images/no_map.png" alt="Crowwater River">
[[Go Back->Continue Road]] 
]
(else:)[
(if: $enemyHpWolf <= 0)[
  (goto: "Wolf Defeated")
]
(if: $playerHp <= 0)[
  (goto: "Game Over")
]
(if: $lastCombatMsg is not "")[
  *(print: $lastCombatMsg)*
]
<video autoplay playsinline loop>
  <source src="videos/wolffight.mp4" type="video/mp4">
</video>
(set: $hpBars to (floor: $enemyHpWolf / $enemyMaxHpWolf * 10))
(set: $hpEmpty to 10 - $hpBars)
Thornfang Wolf *Damage 10-20* HP: [(str-repeated: $hpBars, "█")(str-repeated: $hpEmpty, "░")] (print: $enemyHpWolf)/(print: $enemyMaxHpWolf)
(set: $pBars to (floor: $playerHp / $playerMaxHp * 10))
(set: $pEmpty to 10 - $pBars)
Your HP: [(str-repeated: $pBars, "█")(str-repeated: $pEmpty, "░")] (print: $playerHp)/(print: $playerMaxHp)
(link: "Attack")[
  (set: $dmg to (random: 30, 50))
  (set: $enemyDmg to (random: 10, 20))
  (set: $enemyHpWolf to (max: 0, $enemyHpWolf - $dmg))
   (set: $playerHp to (max: 0, $playerHp - $enemyDmg))
   (set: $lastCombatMsg to "You strike the Wolf for " + (str: $dmg) + " damage. It bites back for " + (str: $enemyDmg) + " damage.")
 (goto: "Follow the tracks")
]
[[Flee->Continue Road]] 

<audio autoplay loop>
  <source src="audio/fight.mp3" type="audio/mpeg">
</audio>
]


:: Game Over {"position":"2350,1425","size":"100,100"}
