:: Search bushes {"position":"2150,1325","size":"100,100"}
(if: $rangerMap is 0)[
<img src="images/no_map.png" alt="Crowwater River">
[[Go Back->Follow the Road]] 
]

(else:)[
(if: $enemyHpBoar <= 0)[
  (goto: "Boar Defeated")
]
(if: $playerHp <= 0)[
  (goto: "Game Over")
]
(if: $lastCombatMsg is not "")[
  *(print: $lastCombatMsg)*
]
<video autoplay playsinline loop>
  <source src="videos/boarfight.mp4" type="video/mp4">
</video>
(set: $hpBars to (floor: $enemyHpBoar / $enemyMaxHpBoar * 10))
(set: $hpEmpty to 10 - $hpBars)
Briarback Boar *Damage 10-20* HP: [(str-repeated: $hpBars, "█")(str-repeated: $hpEmpty, "░")] (print: $enemyHpBoar)/(print: $enemyMaxHpBoar)
(set: $pBars to (floor: $playerHp / $playerMaxHp * 10))
(set: $pEmpty to 10 - $pBars)
Your HP: [(str-repeated: $pBars, "█")(str-repeated: $pEmpty, "░")] (print: $playerHp)/(print: $playerMaxHp)
(link: "Attack")[
  (set: $dmg to (random: 30, 50))
  (set: $enemyDmg to (random: 10, 20))
  (set: $enemyHpBoar to (max: 0, $enemyHpBoar - $dmg))
  (set: $playerHp to (max: 0, $playerHp - $enemyDmg))
(set: $lastCombatMsg to "You strike the Boar for " + (str: $dmg) + " damage. It hits back for " + (str: $enemyDmg) + " damage.")
 (goto: "Search bushes")
]
[[Flee->Follow the Road]] 
<audio autoplay loop>
  <source src="audio/fight.mp3" type="audio/mpeg">
</audio>
<audio autoplay>
  <source src="audio/wolf.mp3" type="audio/mpeg">
</audio>
]


